# Application
T2D_ENVIRONMENT=development
T2D_LOG_LEVEL=INFO
T2D_DATABASE_PATH=.talk2data/talk2data.db
T2D_DEFAULT_TENANT_ID=demo-telecom

# Optional external directories. Leave unset to use packaged approved contracts.
# T2D_DOMAIN_PACK_DIRECTORY=/absolute/path/to/domain-packs
# T2D_PHYSICAL_MAPPING_DIRECTORY=/absolute/path/to/physical-mappings

# Browser origins allowed to call the API. Pydantic settings expects a JSON array.
T2D_CORS_ALLOWED_ORIGINS=["https://yashumani.github.io","http://127.0.0.1:8000","http://localhost:8000"]

# Governed data backend. Use demo_sqlite for the bundled synthetic data or postgresql
# for a read-only mapping-driven physical source.
T2D_DATA_BACKEND=demo_sqlite
T2D_POSTGRES_DSN=
# Optional runtime overrides. When unset, the approved physical mapping supplies object names.
# T2D_POSTGRES_SCHEMA=approved_schema_override
# T2D_POSTGRES_TABLE=approved_view_override
T2D_POSTGRES_MAXIMUM_ROWS=1000
T2D_POSTGRES_QUERY_TIMEOUT_SECONDS=60
T2D_POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# Ollama: local model used for structured language interpretation.
T2D_OLLAMA_ENABLED=true
T2D_OLLAMA_REQUIRED=false
T2D_OLLAMA_BASE_URL=http://127.0.0.1:11434
T2D_OLLAMA_MODEL=qwen3:8b
T2D_OLLAMA_TIMEOUT_SECONDS=90

# Hermes Agent: optional controlled agent runtime backed by the same Ollama server.
T2D_HERMES_ENABLED=false
T2D_HERMES_BASE_URL=http://127.0.0.1:8642
T2D_HERMES_API_KEY=replace-with-a-long-local-secret
T2D_HERMES_TIMEOUT_SECONDS=180
