FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir '.[internal]' \
    && useradd --create-home --uid 10001 talk2data

USER talk2data
EXPOSE 8000
CMD ["uvicorn", "talk2data.internal_main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
