FROM node:24-bookworm-slim AS internal-workspace
WORKDIR /build
COPY apps/web/package*.json ./
RUN npm ci --ignore-scripts
COPY apps/web ./
RUN npm run build:internal

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml README.md ./
COPY requirements ./requirements
COPY scripts/dependencies.py ./scripts/dependencies.py
COPY src ./src
COPY --from=internal-workspace /build/dist-internal /app/internal-web
RUN PIP_NO_CACHE_DIR=1 python scripts/dependencies.py install internal \
    && useradd --create-home --uid 10001 talk2data

USER talk2data
EXPOSE 8000
CMD ["uvicorn", "talk2data.internal_main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
